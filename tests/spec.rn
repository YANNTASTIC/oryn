module geometry {

// ---- Globals (const only) ------------------------------------
const int!32 scale = 3;          // readable from pure functions
const auto label = "shapes";     // inferred as string
const uint!7 small = 100;        // 0..127, stored in 8 bits
const int!7 signed_small = -64;  // -64..63

// ---- Normal (impure) functions: fn with a block --------------
fn clamp(int!32 v, int!32 lo, int!32 hi): int!32 {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

// ---- Flat function: one statement, no braces -----------------
fn bump(int!32 <> n): void n += 1;

// ---- Pure functions: fn with => ------------------------------
fn doubled(int!32 v): int!32 => v * 2;
fn area(int!32 w, int!32 h): int!32 => w * h * scale;

// Pure function with a block body: => before the braces
fn sum_to(int!32 n): int!32 => {
    var int!32 total;            // locals are fine; globals and impure calls are not
    for (var int!32 i = 1; i <= n; i += 1) {
        total += i;
    }
    return total;
}

// ---- Overloading by input type or count (no keyword) ---------
fn half(float!64 v): float!64 => v / 2.0;
fn half(int!32 v): int!32 => v / 2;
fn area(float!64 r): float!64 => 3.14159!64 * r * r;

// ---- Out (->) and inout (<>) parameters ----------------------
// Outs are optional, write-only and not part of the signature.
// There is exactly one parse(string): callers choose how many outs to take.
fn parse(string s, bool -> ok, int!32 -> consumed): int!32 {
    var int!32 result;           // 0
    var bool good = true;
    // ... parsing ...
    ok = good;                   // discarded if the caller omitted it
    consumed = 3;                // discarded if the caller omitted it
    return result;
}

fn swap(int!32 <> a, int!32 <> b): void {
    var int!32 tmp = a;
    a = b;
    b = tmp;
}

// ---- Narrowing needs an explicit cast ------------------------
fn truncate(float!64 f): int!32 => int!32(f);

// ---- Types ---------------------------------------------------
struct Point {
    var float!64 x;              // default 0.0
    var float!64 y;

    fn length(): float!64 => sqrt(x * x + y * y);   // pure: borrows this shared

    fn scale_by(float!64 k): void {                 // impure: borrows this exclusively
        x *= k;
        y *= k;
    }
}

packed struct Header {
    var uint!3 version;          // fields are bit-packed in declaration order
    var uint!5 flags;
    var uint!16 length;          // 24 bits total
}

class Shape {
    var string name = "shape";   // field default

    Shape(string n) {
        name = n;                // n is a borrow, so this copies it
    }

    !Shape() {
        // destructor (implicitly virtual)
    }

    abstract fn area(): float!64;            // abstract: Shape cannot be instantiated
    virtual fn describe(): string => name;   // pure, with a default body
}

class Circle : Shape {
    var float!64 radius = 1.0;   // the default circle has radius 1

    Circle() {
        super("circle");         // base constructor call, must be first
    }

    Circle(float!64 r) {
        super("circle");
        radius = r;
    }

    override fn area(): float!64 => 3.14159!64 * radius * radius;
}

singleton Logger {
    var int!32 lines;            // singleton state, default 0

    fn log(string msg): void {   // exclusive borrow of Logger for the call
        lines += 1;
    }

    fn count(): int!32 => lines; // pure: reads only this
}

// ---- Forced initialization -----------------------------------
fn defaults(): void {
    var int!32 i;                // 0
    var float!64 f;              // 0.0
    var bool b;                  // false
    var string s;                // ""
    var int!32[4] fixed;         // four zeros
    var int!32[] dyn;            // empty
    var Circle c;                // default Circle: radius 1.0, name "circle"
    var Circle* p;               // empty owning pointer
    var Shape* sh;               // empty owning pointer to an abstract type (var Shape sh; is an error)
    var int!32 k = 3;            // explicit initialiser still fine
}

// ---- Containers: bounds and lifetime safety ------------------
fn containers(int!32[] <> items): void {
    items.push(1);                          // the container owns and grows its storage
    var int!32 a = items[0];                // bounds-checked: out of range traps
    var bool ok;
    var int!32 b = items.get(99, -> ok);    // no trap: default value, ok = false

    var int!32@ first = items[0];           // shared reference borrows items
    // items.push(2);                       // ERROR: first is still live
    var int!32 c = first + 1;               // last use of first
    items.push(2);                          // fine now

    var int!32 d = &items.at_unchecked(0);  // hard-block: skips the bounds check
}

// ---- Hard-blocked code (&) -----------------------------------
&fn read_radius(raw_ptr<Circle> p): float!64 {   // whole body is an & scope
    return p.radius;
}

// ---- Pointers and references ---------------------------------
fn ownership(): void {
    var Circle* c = new Circle(2.0);          // owning pointer (unique)
    var Circle* d = move(c);                  // ownership transferred; c is now empty
    var raw_ptr<Circle> r = d.raw();          // creating a raw_ptr is safe

    var float!64 rad = &read_radius(r);       // one hard-blocked call
    &{                                        // a hard-blocked scope
        var int!32 whole = truncate(read_radius(r));
        var float!64 again = r.radius;        // raw_ptr dereference, no extra markers needed
    }

    var int!32 x = 5;
    var int!32@ view = x;                     // shared reference: read-only
    var int!32 y = view + 1;                  // y is 6; view's last use is here
    var int!32 exc@ ref = x;                  // exclusive reference
    ref += 1;                                 // x is now 6
}                                             // d is destroyed here

fn take(Circle* owned): void {                // takes ownership of the circle
    // ... owned is destroyed at the end of this function ...
}

fn give(): void {
    var Circle* c = new Circle(3.0);
    take(move(c));                            // c is empty after this
}

// ---- Control flow --------------------------------------------
// items is an exclusive borrow (inout) because the last loop mutates it.
fn flow(int!32[] <> items, int!32 <> total): void {
    var int!32 i;
    while (i < 10) {
        i += 1;
    }

    for (var int!32 j = 0; j < 10; j += 1) {
        total += j;
    }

    for (var auto (idx, v) ~ en(items)) {     // en is in the standard library
        total += int!32(idx) * v;             // idx is uint!64, so narrowing needs a cast
    }

    for (var int!32 x ~ items) {              // explicit loop variable type
        total += x;
    }

    for (var auto exc@ item ~ items) {        // mutate in place
        item *= 2;
    }
}

// ---- Calling conventions at call sites -----------------------
fn callers(int!32[] <> items): void {
    var int!32 a = parse("42");                  // all outs omitted
    var bool ok;
    var int!32 b = parse("42", -> ok);           // first out supplied
    var int!32 n;
    var int!32 c = parse("42", -> ok, -> n);     // both outs supplied
    var int!32 d = parse("42", -> _, -> n);      // skip the first out, take the second

    bump(<> b);
    swap(<> a, <> b);

    // swap(<> a, <> a);                         // ERROR: a is passed twice, once as inout
    // parse("42", -> n, -> n);                  // ERROR: n is passed to two outs
    // flow(<> items, <> items[0]);              // ERROR: items[0] is inside items

    Logger.log("done");                          // singleton call: safe, no marker

    var Circle* circ = new Circle(1.5);
    var float!64 ar = circ.area();               // instance method (=> method: shared borrow)

    var int!32 limited = geometry.clamp(a, 0, 10);   // module-qualified

    var int!32 total;
    if (ok) {
        total += limited + c + d + n;
    }
    flow(<> items, <> total);
}

// ---- C++ interop ---------------------------------------------
extern "C++" {
    fn cpp_add(int!32 a, int!32 b): int!32;  // implicitly &fn
}

fn interop(): void {
    var int!32 sum = &cpp_add(1, 2);         // extern call needs the marker
}

}

// ============================================================
// Overloads, apply and patch (separate module)
// ============================================================

module fixes {

// Same name, inputs and return type as the original => overload is required.
overload fn Circle.area(): float!64 => 3.14159265358979!64 * radius * radius;

// Same inputs and return, different outs.
overload fn geometry.parse(string s, bool -> ok, int!32 -> consumed, int!32 -> warnings): int!32 {
    // ... improved parser that also reports warnings ...
    return 0;
}

}

fn patched_scope(): void {
    apply fixes Circle area;                 // scoped: only calls in this block see it
    var Circle* c = new Circle(1.0);
    var float!64 a = c.area();               // uses fixes.Circle.area
}

patch fixes Circle area;                     // global: every call in the program sees it
